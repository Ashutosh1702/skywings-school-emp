# ==========================================
# SkyWings School ERP - Git Ignore Rules
# ==========================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Environment Variables & Credentials (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# 3. Production & Build Outputs
dist/
dist-ssr/
build/
out/
.vite/
*.local

# 4. Logs & Diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# 5. Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 6. Operating System & Temporary Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
